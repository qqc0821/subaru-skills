{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subaru-skills/schemas/styles.index.schema.json",
  "title": "styles/index.json",
  "type": "object",
  "required": [
    "schema_version",
    "count",
    "styles"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "sample": {
            "type": "string"
          }
        }
      }
    },
    "theme_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "theme",
          "first"
        ],
        "properties": {
          "theme": {
            "type": "string"
          },
          "first": {
            "type": "string"
          },
          "second": {
            "type": "string"
          },
          "third": {
            "type": "string"
          }
        }
      }
    }
  }
}
