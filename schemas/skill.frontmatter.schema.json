{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subaru-skills/schemas/skill.frontmatter.schema.json",
  "title": "SKILL.md frontmatter",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must equal the skill directory name."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024,
      "description": "Must state when to use the skill, with trigger terms."
    }
  }
}
