{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subaru-skills/schemas/style.preset.schema.json",
  "title": "styles/<id>.md frontmatter preset",
  "type": "object",
  "required": [
    "id",
    "name",
    "base_style_prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_en": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "path": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "accent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "base_style_prompt": {
      "type": "string",
      "minLength": 1
    },
    "layout_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "string"
    },
    "proven": {
      "type": "boolean"
    }
  }
}
